          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>   <!-- Friction coefficient (higher value, less movement) -->
              <mu2>1.0</mu2> <!-- Second friction coefficient -->
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient> <!-- Restitution coefficient (0 for no bouncing) -->
            <threshold>0.0</threshold> <!-- Threshold for considering collision -->
          </bounce>
          <contact>
            <ode>
              <soft_cfm>0.01</soft_cfm> <!-- Soft constraint force mixing (smoother contacts) -->
              <soft_erp>0.8</soft_erp>   <!-- Soft error reduction parameter -->
              <kp>10000.0</kp>           <!-- Contact stiffness (higher value, less movement) -->
              <kd>1.0</kd>               <!-- Contact damping -->
            </ode>
          </contact>
        </surface>
